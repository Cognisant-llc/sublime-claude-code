* text=auto eol=lf
*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.json text eol=lf

# Keep the installed package lean: everything below is for development or
# the GitHub page only (Package Control downloads honor export-ignore).
docs export-ignore
tests export-ignore
scripts/* export-ignore
# ...except the Claude Code hook the Recent Activity panel needs at runtime
# (per-file pattern above so this negation can re-include it).
scripts/activity_hook.py -export-ignore
uv.lock export-ignore
pyproject.toml export-ignore
.gitignore export-ignore
.gitattributes export-ignore
.python-version export-ignore
