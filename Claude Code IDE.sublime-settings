{
	// Start the IDE server when Sublime starts.
	"auto_start": true,

	// Diff review layout mode:
	// - When true (default): Opens diff in a global two-column layout (original on left, proposal on right)
	// - When false: Splits the current pane 50/50 horizontally for side-by-side view
	"open_in_side_group": true,

	// Fixed server port (1024-65535), or null for a random port.
	// A fixed port lets you set machine-wide env vars once
	// (CLAUDE_CODE_SSE_PORT=<port>, ENABLE_IDE_INTEGRATION=true) so every
	// claude session auto-connects. Falls back to random if busy.
	"port": null,

	// Name shown in Claude Code's /ide picker and the lock file.
	"ide_name": "Sublime Text",

	// Debounce for selection_changed notifications (milliseconds).
	"selection_debounce_ms": 200,

	// Print protocol frames and lifecycle events to the Sublime console
	// (View > Show Console). Enable when debugging connection issues.
	"debug": false,

	// Recent Activity panel: files changed by Claude sessions, grouped
	// project → session → file. Needs the hook script registered in
	// ~/.claude/settings.json (see README "Recent Activity").
	"activity_panel": {
		"enabled": true,
		// Open the panel automatically in every window on start.
		"auto_open": true,
		// Group index for the panel (0 = left-most; a 2-column layout is
		// created when the window has a single group).
		"group": 0,
		// Widen the panel's column so at least this many characters fit when
		// it opens (never more than half the window). 0 = leave the layout alone.
		"min_width_chars": 34,
		// Default time window in hours (change per panel with the 1..5 keys).
		"window_hours": 24,
		// false = documents & media only (md/txt/html/pdf/office/images/video);
		// true = every file type. Toggle per panel with "c".
		"show_code": false,
		// "all" = every live session's project; "window" = only files under
		// this window's folders (one Sublime window per project setups).
		"scope": "all",
		// Projects to always hide from the panel. Match by directory basename
		// (e.g. "demo") or by full path. Hide one interactively with the "h"
		// key inside the panel (that list persists separately and is cleared
		// with Shift+H / "Show Hidden Projects").
		"hide_projects": [],
		// Ceiling per session; with fit_to_view the actual number is derived
		// from the pane height so every project stays visible without scrolling.
		"max_files_per_session": 20,
		// Fit the whole tree to the pane: newest file of every session first
		// (round-robin), oldest projects folded when even the rows don't fit
		// (▷ — click to focus one project and expand it fully, ◆).
		"fit_to_view": true,
		// How often to poll the hook log and session list (milliseconds).
		"poll_ms": 2000,
		// Records older than this are dropped from the logs on start.
		"keep_days": 7,
		// Directory names never listed nor watched (matched at any depth).
		"prune": [
			".git", "node_modules", ".venv", "venv", "__pycache__", ".next", ".nuxt",
			"dist", "build", "coverage", ".ruff_cache", ".pytest_cache", ".mypy_cache",
			".cache", ".turbo", ".playwright-cli", "site-packages", ".claude",
			"projects", "session-archive", "shell-snapshots", "file-history",
			"image-cache", "paste-cache", "cache", "logs", "sessions", "tasks", "teams",
			"jobs", "daemon", "tmp", "uploads", "backups", "statsig", "ide"
		],
		// Font size for the panel view only (null = editor default).
		"font_size": null
	}
}
